{
  "name": "fmo-dashboard",
  "private": true,
  "license": "MIT",
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "icons": "tauri icon src-tauri/icon-desktop.png && rimraf src-tauri/icons/android src-tauri/icons/ios",
    "icons:android": "bash scripts/generate-android-icons.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:build": "npm run build && cap sync",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:sim": "bash scripts/ios-simulator.sh",
    "ios:device": "bash scripts/ios-device.sh",
    "android:apk": "bash scripts/build-android-apk.sh",
    "android:apk:release": "bash scripts/build-android-apk.sh --release",
    "android:deploy": "bash scripts/android-deploy.sh",
    "android:deploy:log": "bash scripts/android-deploy.sh --logcat",
    "win:portable": "bash scripts/build-windows-portable.sh",
    "win:portable:x64": "bash scripts/build-windows-portable-exe.sh --arch x64",
    "win:portable:x86": "bash scripts/build-windows-portable-exe.sh --arch x86",
    "win:legacy": "bash scripts/build-windows-portable-exe.sh --legacy --arch x86",
    "win:desktop:x64": "bash scripts/build-windows-desktop.sh --arch x64",
    "win:desktop:x86": "bash scripts/build-windows-desktop.sh --arch x86",
    "win:desktop:arm64": "bash scripts/build-windows-desktop.sh --arch arm64",
    "win:desktop:release": "bash scripts/build-windows-desktop-release.sh",
    "win:portable:release": "bash scripts/build-windows-release.sh",
    "win:release": "bash scripts/build-windows-desktop-release.sh",
    "test:url": "node scripts/test-url-utils.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@anuradev/capacitor-background-mode": "^7.2.1",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "crypto-js": "^4.2.0",
    "pinia": "^3.0.4",
    "sql.js": "^1.13.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.7.0",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.3",
    "terser": "^5.48.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.4",
    "vue-tsc": "^2.1.10"
  }
}
